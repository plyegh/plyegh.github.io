---
import { render } from 'astro:content';
import Public from '../../../../layouts/Public.astro';
import DocViewer from '../../../../components/DocViewer.astro';
import { PROFILE, PUBLIC, PUBLIC_PROFILE, categoryKo } from '../../../../data/site';
import { getPublicPosts, formatDate, formatDateKo, readingMinutes, seriesOf, type Post } from '../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublicPosts(); // newest first
  return posts.map((post, i) => ({
    params: { category: post.category, slug: post.slug },
    props: {
      post,
      newer: posts[i - 1],
      older: posts[i + 1],
      series: post.data.series ? seriesOf(posts, post.data.series) : [],
    },
  }));
}
interface Props { post: Post; newer?: Post; older?: Post; series: Post[] }
const { post, newer, older, series } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const seriesIndex = series.findIndex((p) => p.id === post.id);
---
<Public title={post.data.title} description={post.data.description} type="article" publishedTime={post.data.date}>
  <div class="wrap p-post">
    <article data-pagefind-body data-pagefind-meta={`date:${formatDate(post.data.date)}`} data-pagefind-filter={`category:${post.category}`}>
      <span data-pagefind-filter="site:public" hidden></span>
      <a class="p-back" href={`${PUBLIC}/`} data-pagefind-ignore>← 블로그</a><br>
      <a class="p-chip" href={`${PUBLIC}/posts/${post.category}/`} data-pagefind-ignore>{categoryKo(post.category)}</a>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="p-sub">{post.data.description}</p>}
      <div class="p-byline" data-pagefind-ignore>
        <img src={PROFILE.avatar} alt="" width="36" height="36">
        <div><b>{PUBLIC_PROFILE.name}</b><time datetime={post.data.date.toISOString()}>{formatDateKo(post.data.date)}</time> · 읽는 데 {readingMinutes(post)}분</div>
      </div>

      {series.length > 1 && (
        <nav class="p-series" aria-label="시리즈" data-pagefind-ignore>
          <p>{post.data.series} <span>· {seriesIndex + 1}/{series.length}</span></p>
          <ol>
            {series.map((p) => (
              <li>{p.id === post.id ? <span aria-current="page">{p.data.title}</span> : <a href={p.url}>{p.data.title}</a>}</li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose" id="prose" style={post.data.imageWidth ? `--img-max: ${post.data.imageWidth}px` : undefined}>
        {post.data.docs.length > 0 && <DocViewer category={post.category} slug={post.slug} docs={post.data.docs} />}
        <Content />
      </div>

      <footer class="p-post-foot" data-pagefind-ignore>
        {post.data.tags.length > 0 && <ul class="p-tags" aria-label="태그">{post.data.tags.map((t) => <li>#{t}</li>)}</ul>}
        {(older || newer) && (
          <nav class="p-pager" aria-label="다른 글">
            {older && <a class="prev" href={older.url}><span>← 이전 글</span>{older.data.title}</a>}
            {newer && <a class="next" href={newer.url}><span>다음 글 →</span>{newer.data.title}</a>}
          </nav>
        )}
      </footer>
    </article>

    {toc.length >= 3 && (
      <aside class="toc p-toc" aria-label="목차">
        <p>목차</p>
        <nav>{toc.map((h) => <a class={`d${h.depth}`} href={`#${h.slug}`}>{h.text}</a>)}</nav>
      </aside>
    )}
  </div>
</Public>

<script>
  import { enhancePost } from '../../../../lib/post-client';
  import { enableImageZoom } from '../../../../lib/image-viewer';
  const prose = document.getElementById('prose')!;
  enhancePost(prose, { copy: '복사', copied: '복사됨' });
  enableImageZoom(prose, { open: '크게 보기', prev: '이전 이미지', next: '다음 이미지', close: '닫기' });
</script>
