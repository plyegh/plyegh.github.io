---
import Base from '../layouts/Base.astro';
---
<Base title="search" description="Search posts on plyegh.">
  <div class="wrap">
    <header class="page-head">
      <nav class="crumbs" aria-label="Path"><a href="/">~</a>/<span class="here">search</span>/</nav>
      <h1>Search</h1>
    </header>
    <div class="search-page">
      <label class="search-box" for="q">
        <span class="ps">$ grep -ri</span>
        <input id="q" type="search" placeholder="keyword…" autocomplete="off" spellcheck="false" enterkeyhint="search">
        <span class="ps dim">~/posts</span>
      </label>
      <p class="search-status" id="status" aria-live="polite"></p>
      <ul class="post-list search-results" id="results"></ul>
    </div>
  </div>
</Base>

<script>
  import { searchPosts } from '../lib/search-client';

  const input = document.getElementById('q') as HTMLInputElement;
  const status = document.getElementById('status')!;
  const list = document.getElementById('results')!;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  let seq = 0;
  async function run(q: string) {
    const my = ++seq;
    const url = new URL(location.href);
    if (q) url.searchParams.set('q', q); else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    if (!q.trim()) { list.innerHTML = ''; status.textContent = ''; return; }
    try {
      const { total, hits } = await searchPosts(q);
      if (my !== seq) return; // a newer query already started
      status.textContent = total ? `${total} match${total === 1 ? '' : 'es'}` : 'no matches';
      // excerpts come from our own Pagefind index: escaped text plus <mark> highlights
      list.innerHTML = hits.map((h) => `
        <li class="post-item"><a href="${esc(h.url)}">
          <div class="post-item-meta">${h.cat ? `<span class="cat">/${esc(h.cat)}</span>` : ''}<span>${esc(h.date)}</span></div>
          <h3>${esc(h.title)}</h3>
          <p class="post-item-desc">${h.excerpt}</p>
        </a></li>`).join('');
    } catch {
      status.textContent = 'search index not found — it is built by `npm run build` (try `npm run preview`).';
    }
  }

  let t: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => { clearTimeout(t); t = setTimeout(() => run(input.value), 180); });
  const initial = new URLSearchParams(location.search).get('q') || '';
  input.value = initial;
  if (initial) run(initial);
  input.focus();
</script>
