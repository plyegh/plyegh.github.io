---
import Base from '../../layouts/Base.astro';
import Terminal from '../../components/Terminal.astro';
import SidePanel from '../../components/SidePanel.astro';
import PostList from '../../components/PostList.astro';
import { getPersonalPosts, pinnedFirst } from '../../lib/posts';

const posts = await getPersonalPosts();
---
<Base>
  <section class="hero">
    <h1 class="sr-only">plyegh — playground</h1>
    <div class="wrap hero-inner">
      <Terminal posts={posts} />
      <SidePanel />
    </div>
    <a class="scroll-cue" href="#latest" aria-label="Scroll to latest posts">Scroll</a>
  </section>

  <section id="latest" class="section">
    <div class="wrap reveal">
      <header class="section-head">
        <p class="eyebrow"><span class="dim">$</span>ls -t ~/posts | head</p>
        <h2>Latest posts</h2>
      </header>
      <PostList posts={pinnedFirst(posts).slice(0, 5)} />
      {posts.length > 5 && <a class="text-link" href="/personal/posts/">all posts →</a>}
    </div>
  </section>
</Base>
