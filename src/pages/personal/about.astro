---
import Base from '../../layouts/Base.astro';
import AboutSections from '../../components/AboutSections.astro';
import { ABOUT_INTRO } from '../../data/about';
import { PROFILE, LINKS, CONTACT_EMAIL, LINK_HANDLE } from '../../data/site';
---
<Base title="about" description={`About ${PROFILE.name} — ${PROFILE.focus}.`}>
  <div class="wrap">
    <header class="page-head">
      <nav class="crumbs" aria-label="Path"><a href="/personal/">~</a>/<span class="here">about</span>/</nav>
      <h1>About</h1>
      <p class="lead">{ABOUT_INTRO}</p>
    </header>

    <div class="about-layout">
      <AboutSections />

      <aside class="about-side">
        <section class="about-contact">
          <p class="eyebrow"><span class="dim">$</span>cat ~/contact</p>
          <ul>
            <li><span class="k">email</span><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
            {LINKS.map((l) => (
              <li><span class="k">{l.id}</span><a href={l.href} target="_blank" rel="noopener">{LINK_HANDLE[l.id] ?? l.href} ↗</a></li>
            ))}
          </ul>
        </section>
      </aside>
    </div>
  </div>
</Base>
