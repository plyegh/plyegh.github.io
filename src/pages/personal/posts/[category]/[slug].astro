---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import Comments from '../../../../components/Comments.astro';
import DocViewer from '../../../../components/DocViewer.astro';
import { categoryName, categoryLabel } from '../../../../data/site';
import { getPersonalPosts, formatDate, seriesOf, tagUrl, type Post } from '../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPersonalPosts(); // newest first
  return posts.map((post, i) => ({
    params: { category: post.category, slug: post.slug },
    props: {
      post,
      newer: posts[i - 1],
      older: posts[i + 1],
      series: post.data.series ? seriesOf(posts, post.data.series) : [],
    },
  }));
}
interface Props { post: Post; newer?: Post; older?: Post; series: Post[] }
const { post, newer, older, series } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const minutes = Math.max(1, Math.round((post.body ?? '').length / 900));
const seriesIndex = series.findIndex((p) => p.id === post.id);
---
<Base title={post.data.title} description={post.data.description} type="article" publishedTime={post.data.date}>
  <div class="progress" aria-hidden="true"><span></span></div>
  <article class="post" data-pagefind-body data-pagefind-meta={`date:${formatDate(post.data.date)}`} data-pagefind-filter={`category:${post.category}`}>
    <span data-pagefind-filter="site:personal" hidden></span>
    <header class="wrap post-head">
      <div class="post-head-inner">
        <nav class="crumbs" aria-label="Path" data-pagefind-ignore>
          <a href="/personal/">~</a>/<a href="/personal/posts/">posts</a>/<a href={`/personal/posts/${post.category}/`}>{categoryLabel(post.category)}</a>/<span class="here">{post.slug}</span>
        </nav>
        <h1>{post.data.title}</h1>
        {post.data.description && <p class="lead">{post.data.description}</p>}
        <p class="post-meta" data-pagefind-ignore>
          <a class="cat" href={`/personal/posts/${post.category}/`}>{categoryName(post.category)}</a>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span>{minutes} min read</span>
          {post.data.draft && <span class="draft-badge">DRAFT</span>}
        </p>
        {series.length > 1 && (
          <nav class="series-box" aria-label="Series" data-pagefind-ignore>
            <p class="series-head"><span>SERIES</span> {post.data.series} <span class="dim">· {seriesIndex + 1}/{series.length}</span></p>
            <ol>
              {series.map((p) => (
                <li>{p.id === post.id
                  ? <span class="here" aria-current="page">{p.data.title}</span>
                  : <a href={p.url}>{p.data.title}</a>}</li>
              ))}
            </ol>
          </nav>
        )}
      </div>
    </header>

    <div class="wrap post-grid">
      <div class="prose" id="prose" style={post.data.imageWidth ? `--img-max: ${post.data.imageWidth}px` : undefined}>
        {post.data.docs.length > 0 && <DocViewer category={post.category} slug={post.slug} docs={post.data.docs} />}
        <Content />
      </div>
      {toc.length >= 3 && (
        <aside class="toc" aria-label="On this page" data-pagefind-ignore>
          <p class="toc-title">ON THIS PAGE</p>
          <nav>
            {toc.map((h) => <a class={`d${h.depth}`} href={`#${h.slug}`}>{h.text}</a>)}
          </nav>
        </aside>
      )}
    </div>

    <footer class="wrap post-foot">
      {post.data.tags.length > 0 && (
        <ul class="tags">{post.data.tags.map((t) => <li><a href={tagUrl(t)}>#{t}</a></li>)}</ul>
      )}
      {(older || newer) && (
        <nav class="pager" aria-label="More posts" data-pagefind-ignore>
          {older && <a class="prev" href={older.url}><span class="mono">← older</span>{older.data.title}</a>}
          {newer && <a class="next" href={newer.url}><span class="mono">newer →</span>{newer.data.title}</a>}
        </nav>
      )}
      <Comments />
    </footer>
  </article>
</Base>

<script>
  import { enhancePost } from '../../../../lib/post-client';
  enhancePost(document.getElementById('prose')!);
</script>
