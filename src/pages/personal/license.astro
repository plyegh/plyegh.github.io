---
import Base from '../../layouts/Base.astro';
import LicenseText from '../../components/LicenseText.astro';
const year = new Date().getFullYear();
---
<Base title="license" description="Copyright and usage terms for plyegh.github.io — all rights reserved.">
  <div class="wrap">
    <header class="page-head">
      <nav class="crumbs" aria-label="Path"><a href="/personal/">~</a>/<span class="here">license</span>/</nav>
      <h1>License</h1>
      <p class="lead">© {year} Dongjun Park (plyegh). All rights reserved.</p>
    </header>

    <div class="prose license">
      <LicenseText aboutHref="/public/about/" />
    </div>
  </div>
</Base>
