---
import Base from '../layouts/Base.astro';
import AboutItem from '../components/AboutItem.astro';
import { ABOUT, ABOUT_INTRO, TOP_RANK } from '../data/about';
import { PROFILE, LINKS } from '../data/site';

const chevron = '<svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>';
const isTop = (item: { rank?: number }) => item.rank !== undefined && item.rank <= TOP_RANK;

const email = 'bdongjun343@gmail.com';
// friendly handle shown instead of the raw URL
const HANDLE: Record<string, string> = {
  github: '@plyegh',
  dreamhack: 'plyegh',
  linkedin: '박동준',
  instagram: '@d_zun0210',
  discord: '@plyegh',
};
---
<Base title="about" description={`About ${PROFILE.name} — ${PROFILE.focus}.`}>
  <div class="wrap">
    <header class="page-head">
      <nav class="crumbs" aria-label="Path"><a href="/">~</a>/<span class="here">about</span>/</nav>
      <h1>About</h1>
      <p class="lead">{ABOUT_INTRO}</p>
    </header>

    <div class="about-layout">
      <div class="about-timeline">
        {ABOUT.map((section) => {
          const top = section.items.filter(isTop);
          const rest = section.items.filter((i) => !isTop(i));
          return (
            <details class="about-section" open>
              <summary>
                <span class={`dot dot-${section.dot}`} aria-hidden="true"></span>
                <span class="sec-title">{section.title}</span>
                <span class="sec-count">{section.items.length}</span>
                <Fragment set:html={chevron} />
              </summary>
              {section.title === 'CTF' ? (
                <div class="ctf-groups">
                  <details class="ctf-group" open>
                    <summary><span class="gl">Top {TOP_RANK}</span><span class="sec-count">{top.length}</span><Fragment set:html={chevron} /></summary>
                    {top.length ? <ul class="about-items">{top.map((item) => <AboutItem item={item} />)}</ul>
                      : <p class="group-empty">아직 Top {TOP_RANK} 기록이 없어요.</p>}
                  </details>
                  <details class="ctf-group" open>
                    <summary><span class="gl">Below {TOP_RANK}</span><span class="dim">· Unplaced</span><span class="sec-count">{rest.length}</span><Fragment set:html={chevron} /></summary>
                    {rest.length ? <ul class="about-items">{rest.map((item) => <AboutItem item={item} />)}</ul>
                      : <p class="group-empty">없음</p>}
                  </details>
                </div>
              ) : (
                <ul class="about-items">{section.items.map((item) => <AboutItem item={item} />)}</ul>
              )}
            </details>
          );
        })}
      </div>

      <aside class="about-side">
        <section class="about-contact">
          <p class="eyebrow"><span class="dim">$</span>cat ~/contact</p>
          <ul>
            <li><span class="k">email</span><a href={`mailto:${email}`}>{email}</a></li>
            {LINKS.map((l) => (
              <li><span class="k">{l.id}</span><a href={l.href} target="_blank" rel="noopener">{HANDLE[l.id] ?? l.href} ↗</a></li>
            ))}
          </ul>
        </section>
      </aside>
    </div>
  </div>
</Base>
