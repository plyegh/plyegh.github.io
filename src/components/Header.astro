---
import Logo from './Logo.astro';
import { CATEGORIES } from '../data/site';
import { getPosts, countByCategory } from '../lib/posts';

const posts = await getPosts();
const counts = countByCategory(posts);
const path = Astro.url.pathname;
const inPosts = path.startsWith('/posts');
const activeCat = inPosts ? path.split('/')[2] || '' : null;
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="plyegh home">
      <Logo />
      <span class="wordmark">plyegh<span class="cur">_</span></span>
    </a>
    <nav class="nav" aria-label="Main">
      <a class="nav-link" href="/" aria-current={path === '/' ? 'page' : undefined}><span>/</span>home</a>
      <div class="nav-item has-menu" id="postsItem">
        <a class="nav-link" href="/posts/" aria-current={inPosts ? 'page' : undefined}><span>/</span>posts</a>
        <button class="nav-caret" type="button" aria-label="Post categories" aria-expanded="false" aria-controls="postsMenu">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="menu" id="postsMenu">
          <div class="menu-panel" id="menuPanel">
            <a class="menu-all" href="/posts/" style="--i:0" aria-current={activeCat === '' ? 'page' : undefined}>
              <span>all posts</span><span class="count">{posts.length}</span>
            </a>
            {CATEGORIES.map((c, i) => (
              <a href={`/posts/${c.slug}/`} style={`--i:${i + 1}`} aria-current={activeCat === c.slug ? 'page' : undefined}>
                <span class="branch">{i === CATEGORIES.length - 1 ? '└─' : '├─'}</span>
                <span class="slug">{c.slug}/</span>
                <span class="name">{c.name}</span>
                <span class="count">{counts[c.slug]}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
      <a class="nav-link" href="/tags/" aria-current={path.startsWith('/tags') ? 'page' : undefined}><span>/</span>tags</a>
      <a class="nav-link" href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}><span>/</span>about</a>
    </nav>
    <div class="header-actions">
      <a class="icon-btn" href="/search/" aria-label="Search posts" aria-current={path.startsWith('/search') ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg>
      </a>
      <button class="theme-toggle" type="button" aria-label="Toggle dark/light theme">
        <svg class="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;

  // theme toggle (shared with the terminal's `theme` command via the plyegh:theme event)
  const currentTheme = () => root.dataset.theme || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  const setTheme = (t: string) => { root.dataset.theme = t; try { localStorage.setItem('plyegh-theme', t); } catch {} };
  document.querySelector('.theme-toggle')!.addEventListener('click', () => setTheme(currentTheme() === 'light' ? 'dark' : 'light'));
  window.addEventListener('plyegh:theme', (e) => {
    const want = (e as CustomEvent<string | undefined>).detail;
    setTheme(want === 'dark' || want === 'light' ? want : currentTheme() === 'light' ? 'dark' : 'light');
  });

  // /posts dropdown: CSS opens it on hover; the caret button handles touch + keyboard
  const item = document.getElementById('postsItem')!;
  const caret = item.querySelector<HTMLButtonElement>('.nav-caret')!;
  const setMenu = (open: boolean) => { item.classList.toggle('open', open); caret.setAttribute('aria-expanded', String(open)); };
  caret.addEventListener('click', (e) => { e.stopPropagation(); item.classList.remove('suppress'); setMenu(!item.classList.contains('open')); });
  item.addEventListener('mouseenter', () => {
    if (matchMedia('(hover: hover)').matches && !item.classList.contains('suppress')) caret.setAttribute('aria-expanded', 'true');
  });
  item.addEventListener('mouseleave', () => { if (!item.classList.contains('open')) caret.setAttribute('aria-expanded', 'false'); });
  item.addEventListener('focusout', (e) => { if (!item.contains(e.relatedTarget as Node)) setMenu(false); });
  document.getElementById('menuPanel')!.addEventListener('click', (e) => {
    const a = (e.target as Element).closest('a'); if (!a) return;
    setMenu(false); item.classList.add('suppress'); a.blur();
  });
  document.addEventListener('pointermove', (e) => {
    if (item.classList.contains('suppress') && !item.contains(e.target as Node)) item.classList.remove('suppress');
  });
  document.addEventListener('click', (e) => { if (!item.contains(e.target as Node)) setMenu(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && item.classList.contains('open')) { setMenu(false); caret.focus(); } });
</script>
