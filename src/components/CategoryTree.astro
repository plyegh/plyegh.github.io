---
import { CATEGORIES } from '../data/site';
import type { Post } from '../lib/posts';
import { countByCategory } from '../lib/posts';
interface Props { posts: Post[]; active: string } // active: '' = all posts
const { posts, active } = Astro.props;
const counts = countByCategory(posts);
---
<aside class="tree" aria-label="Categories">
  <nav>
    <a class="tree-root" href="/posts/" aria-current={active === '' ? 'page' : undefined}>
      <span>~/posts/</span><span class="count">{posts.length}</span>
    </a>
    <ul>
      {CATEGORIES.map((c, i) => (
        <li>
          <a href={`/posts/${c.slug}/`} aria-current={active === c.slug ? 'page' : undefined}>
            <span class="branch">{i === CATEGORIES.length - 1 ? '└─' : '├─'}</span>{c.slug}/<span class="count">{counts[c.slug]}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>
