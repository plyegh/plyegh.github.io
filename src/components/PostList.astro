---
import { formatDate, type Post } from '../lib/posts';
interface Props { posts: Post[]; showCategory?: boolean; emptyText?: string }
const { posts, showCategory = true, emptyText = 'No posts yet.' } = Astro.props;
---
{posts.length ? (
  <ul class="post-list">
    {posts.map((p) => (
      <li class="post-item">
        <a href={p.url}>
          <div class="post-item-meta">
            {p.data.pinned && <span class="pin-badge">PINNED</span>}
            {showCategory && <span class="cat">/{p.category}</span>}
            <span>{formatDate(p.data.date)}</span>
            {p.data.series && <span class="series-tag">series: {p.data.series}</span>}
            {p.data.draft && <span class="draft-badge">DRAFT</span>}
          </div>
          <h3>{p.data.title}</h3>
          {p.data.description && <p class="post-item-desc">{p.data.description}</p>}
        </a>
      </li>
    ))}
  </ul>
) : (
  <p class="empty-state">{emptyText}</p>
)}
